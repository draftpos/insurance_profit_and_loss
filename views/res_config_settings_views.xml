<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_insurance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.insurance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Insurance Reports" name="insurance_profit_and_loss">
                    <block title="Accounting Reports">
                        <setting id="insurance_pnl_setting" title="Insurance Profit and Loss" help="Use the custom Insurance layout for the Profit and Loss report.">
                            <field name="enable_insurance_pnl_format"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
