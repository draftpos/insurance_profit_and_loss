<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <record id="insurance_profit_and_loss" model="account.report">
        <field name="name">Insurance Profit and Loss</field>
        <field name="root_report_id" ref="account_reports.profit_and_loss"/>
        <field name="sequence">999</field>
        <field name="filter_date_range" eval="True"/>
        <field name="filter_analytic_groupby" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_journals" eval="True"/>
        <field name="filter_budgets" eval="True"/>
        <field name="filter_multi_company">selector</field>
        <field name="allow_account_audit_status_on_lines" eval="True"/>
        <field name="default_opening_date_filter">this_year</field>
        <field name="column_ids">
            <record id="insurance_pnl_balance" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <!-- 1. Revenue -->
            <record id="insurance_pnl_revenue" model="account.report.line">
                <field name="name">Revenue</field>
                <field name="sequence">10</field>
                <field name="code">INS_REV</field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="insurance_pnl_revenue_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', 'in', ('income', 'income_other'))]"/>
                        <field name="subformula">-sum</field>
                    </record>
                </field>
            </record>

            <!-- 2. Direct Expenses -->
            <record id="insurance_pnl_direct_expenses" model="account.report.line">
                <field name="name">Direct Expenses</field>
                <field name="sequence">20</field>
                <field name="code">INS_DIR_EXP</field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="insurance_pnl_direct_expenses_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', '=', 'expense_direct_cost')]"/>
                        <field name="subformula">sum</field>
                        <field name="green_on_positive" eval="False"/>
                    </record>
                </field>
            </record>

            <!-- 3. Net Client Cash Flow -->
            <record id="insurance_pnl_net_cash_flow" model="account.report.line">
                <field name="name">Net client cash flow</field>
                <field name="sequence">30</field>
                <field name="code">INS_NET_CF</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="insurance_pnl_net_cash_flow_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">INS_REV.balance - INS_DIR_EXP.balance</field>
                    </record>
                </field>
            </record>

            <!-- 4. Operating Expenses -->
            <record id="insurance_pnl_operating_expenses" model="account.report.line">
                <field name="name">Operating Expenses</field>
                <field name="sequence">40</field>
                <field name="code">INS_OP_EXP</field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="insurance_pnl_operating_expenses_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <!-- Normal expenses excluding explicitly categorized ones -->
                        <field name="formula" eval="[('account_id.account_type', 'in', ('expense', 'expense_depreciation', 'expense_other')), ('account_id.insurance_report_category', '=', False)]"/>
                        <field name="subformula">sum</field>
                        <field name="green_on_positive" eval="False"/>
                    </record>
                </field>
            </record>

            <!-- 5. Other Operating Expenses -->
            <record id="insurance_pnl_other_operating_expenses" model="account.report.line">
                <field name="name">Other Operating Expenses</field>
                <field name="sequence">50</field>
                <field name="code">INS_OTH_OP</field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="insurance_pnl_other_operating_expenses_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.insurance_report_category', 'in', ('management_fees_general', 'management_fees_managed'))]"/>
                        <field name="subformula">sum</field>
                        <field name="green_on_positive" eval="False"/>
                    </record>
                </field>
            </record>

            <!-- 6. Operating Surplus -->
            <record id="insurance_pnl_operating_surplus" model="account.report.line">
                <field name="name">Operating Surplus</field>
                <field name="sequence">60</field>
                <field name="code">INS_OP_SURP</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="insurance_pnl_operating_surplus_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">INS_NET_CF.balance - INS_OP_EXP.balance - INS_OTH_OP.balance</field>
                    </record>
                </field>
            </record>

            <!-- 7. Total Investment Income -->
            <record id="insurance_pnl_investment_income" model="account.report.line">
                <field name="name">Total Investment Income</field>
                <field name="sequence">70</field>
                <field name="code">INS_INV_INC</field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="insurance_pnl_investment_income_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.insurance_report_category', 'in', ('other_income', 'unrealised_profit'))]"/>
                        <field name="subformula">-sum</field>
                    </record>
                </field>
            </record>

            <!-- 8. Surplus -->
            <record id="insurance_pnl_surplus" model="account.report.line">
                <field name="name">Surplus</field>
                <field name="sequence">80</field>
                <field name="code">INS_SURPLUS</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="insurance_pnl_surplus_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">INS_OP_SURP.balance + INS_INV_INC.balance</field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
